# Продакшен-сборка. Секретов здесь нет и быть не должно (всё, что в REACT_APP_*, попадает в бандл).
# Source map не публикуем: исходники сайта раньше восстанавливались именно из них.
GENERATE_SOURCEMAP=false
# Рантайм-чанк отдельным файлом, а не inline-скриптом в index.html — нужно для будущего CSP без unsafe-inline.
INLINE_RUNTIME_CHUNK=false
